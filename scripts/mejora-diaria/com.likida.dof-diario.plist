<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.likida.dof-diario</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/mejora-diaria/rutina.sh</string>
    <string>dof-diario</string>
    <string>WebSearch WebFetch</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/.mejora-diaria/logs/dof-diario.log</string>
  <key>StandardErrorPath</key><string>__REPO__/.mejora-diaria/logs/dof-diario.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
