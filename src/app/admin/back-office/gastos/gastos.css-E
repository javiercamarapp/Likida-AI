/* Gastos y tesorería del Back-office. Solo tokens globales (--ink, --muted, --line, --surface). Sin hex, sin style en el JSX. */
[data-ui="v2"] .bo-celda { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
[data-ui="v2"] .bo-celda__nombre { font-weight: 500; color: var(--ink); overflow-wrap: anywhere; }
[data-ui="v2"] .bo-celda__tenue { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
[data-ui="v2"] .bo-sugeridos { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 4px; }
[data-ui="v2"] .bo-sugeridos > form { flex: 0 0 auto; }
[data-ui="v2"] .bo-monto { white-space: nowrap; font-variant-numeric: tabular-nums; }
