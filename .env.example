# ─── WhatsApp Cloud API (Meta) — número NUEVO de Cuadra ───────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=            # token que tú inventas para verificar el webhook
WHATSAPP_APP_SECRET=

# ─── OpenRouter (gateway LLM único: Gemini + Claude, con ZDR forzado) ─────
OPENROUTER_API_KEY=
# Overrides opcionales por rol (si se omiten, usan los defaults de
# src/lib/llm/models.ts). Slugs de OpenRouter:
# CUADRA_MODEL_OCR=google/gemini-3.6-flash
# CUADRA_MODEL_CUADRE=anthropic/claude-sonnet-5
# CUADRA_MODEL_CUADRE_FALLBACK=anthropic/claude-opus-5
# CUADRA_MODEL_CHAT=google/gemini-3.5-flash-lite
# CUADRA_MODEL_ROUTER=google/gemini-3.5-flash-lite
# Plan B demo en vivo (llaves directas por si OpenRouter cae):
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ─── Supabase (DB + auth) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Facturapi (validación CFDI / Carta Porte) ────────────────────────────
FACTURAPI_KEY=

# ─── Upstash (colas / rate-limit) ─────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
QSTASH_TOKEN=

# ─── Sentry (observabilidad) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
