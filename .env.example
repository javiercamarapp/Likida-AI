# ─── WhatsApp Cloud API (Meta) — número NUEVO de Cuadra ───────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=            # token que tú inventas para verificar el webhook
WHATSAPP_APP_SECRET=

# ─── Anthropic (Claude) — OCR de comprobantes + razonamiento de cuadre ────
ANTHROPIC_API_KEY=
# Modelos (se afinan tras el benchmark de subagentes)
CUADRA_MODEL_OCR=claude-...        # visión para extraer comprobantes
CUADRA_MODEL_CUADRE=claude-...     # razonamiento de conciliación
CUADRA_MODEL_CHAT=claude-...       # turnos de conversación de alto volumen

# ─── Supabase (DB + auth) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Facturapi (validación CFDI / Carta Porte) ────────────────────────────
FACTURAPI_KEY=

# ─── Upstash (colas / rate-limit) ─────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
QSTASH_TOKEN=

# ─── Sentry (observabilidad) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
