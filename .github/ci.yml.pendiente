# ⚠️  ESTE ARCHIVO NO ESTÁ ACTIVO. Para activarlo:
#
#     git mv .github/ci.yml.pendiente .github/workflows/ci.yml
#     git commit -m "Activar CI"
#     git push
#
# Y antes, UNA sola vez, darle al token el permiso que le falta:
#
#     gh auth refresh -h github.com -s workflow
#
# (abre el navegador; hay que completar el flujo ahí, no basta con lanzarlo)
#
# POR QUÉ VIVE AQUÍ Y NO EN .github/workflows/: GitHub rechaza cualquier push que
# cree o modifique un archivo bajo `.github/workflows/` si el token OAuth no
# tiene el scope `workflow` — y el de esta máquina tiene 'gist', 'read:org',
# 'repo'. El rechazo es del push ENTERO, así que un solo commit con un workflow
# bloquea todos los que vengan detrás.
#
# El contenido de abajo está probado: `npm ci --dry-run` contra el lockfile, y
# build + tests con `env -i` y sin .env.local en disco, que es como corre CI.
# ─────────────────────────────────────────────────────────────────────────────

# Las cuatro puertas que hoy se corren a mano antes de cada commit.
#
# Nada de esto llama a un modelo ni toca Supabase: la suite de `npm test` es
# offline y reproducible a propósito (los arneses que sí gastan dinero se llaman
# `*.prueba.ts` y viven fuera del include de vitest). Por eso CI no necesita
# secretos, y por eso puede correr en cada push sin costo.
name: CI

on:
  push:
    branches: [master, main]
  pull_request:

# Un push nuevo cancela la corrida anterior de la misma rama: no sirve de nada
# esperar el resultado de un commit que ya quedó atrás.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verificar:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      # `npm ci` y no `npm install`: instala exactamente el lockfile y falla si
      # se desincronizó del package.json, que es justo lo que se quiere saber.
      - run: npm ci

      - name: Typecheck
        run: npm run typecheck

      - name: Lint
        run: npm run lint

      - name: Tests
        run: npm test

      # El build va al final porque es el más lento, y porque los tres de arriba
      # atrapan casi todo lo que lo haría fallar. Ya cazó un fallo real que solo
      # aparecía aquí: Turbopack no resolvía el .wasm del lector de códigos.
      - name: Build
        run: npm run build
        env:
          # El build no llama a nadie, pero Next evalúa los módulos y algunos
          # leen el entorno al importarse. Valores de relleno: si alguno se usara
          # de verdad, el fallo sería ruidoso en vez de silencioso.
          OPENROUTER_API_KEY: ci-placeholder
          NEXT_PUBLIC_SUPABASE_URL: https://ci-placeholder.supabase.co
          NEXT_PUBLIC_SUPABASE_ANON_KEY: ci-placeholder
          SUPABASE_SERVICE_ROLE_KEY: ci-placeholder
