{
  "name": "likida",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de IA por WhatsApp que automatiza el cierre diario de operaciones logísticas en México.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "seed": "bash scripts/seed.sh",
    "setup": "npm install && npm run seed",
    "ticket": "vitest run arnes_ticket_real",
    "auditoria": "vitest run --config vitest.audit.config.ts scripts/auditoria/loop.audit.ts",
    "auditoria:baselina": "vitest run --config vitest.audit.config.ts scripts/auditoria/loop.audit.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.0.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.0",
    "@upstash/qstash": "^2.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0",
    "zxing-wasm": "^3.1.2"
  },
  "//overrides": "sharp procesa las fotos que llegan por WhatsApp — entrada NO autenticada. Next trae su propia copia anidada, así que subir la dependencia directa no basta: sin este override quedaba un sharp <0.35.0 vulnerable (CVE-2026-33327/33328/35590/35591 en libvips) en el árbol, alcanzable desde la primera foto de un chofer.",
  "overrides": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}