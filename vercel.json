{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git log -1 --pretty=%B | grep -qi '\\[deploy\\]' && exit 1 || exit 0",
  "crons": [
    {
      "path": "/api/cron/escalar",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/facturar",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/purgar",
      "schedule": "15 4 * * *"
    }
  ]
}
