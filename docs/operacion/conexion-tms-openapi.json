{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrato SUPUESTO del adaptador TMS de Likida",
    "version": "0.1.0-supuesto",
    "description": "Lo que Likida ASUME del sistema de transporte del cliente. NO es su especificación: cada ruta, campo, formato y límite debe confirmarse o corregirse. Nada de esto describe una conexión existente. Solo lectura (más el login). Texto en UTF-8; si llega con mojibake, Likida lo repara."
  },
  "servers": [
    {
      "url": "https://SUPUESTO-base-url-del-tms",
      "description": "Por conectar: la dirección real viene de la credencial de la flota."
    }
  ],
  "security": [
    {
      "sesion": []
    }
  ],
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Login de cuenta de servicio (SUPUESTO)",
        "description": "Cuerpo: usuario, clave. El token vuelve en «token» y se manda en «Authorization» con prefijo «Bearer ».",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "usuario": {
                    "type": "string"
                  },
                  "clave": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token."
          },
          "401": {
            "description": "Credencial rechazada: Likida se detiene y alerta, no insiste."
          }
        },
        "x-supuesto": true
      }
    },
