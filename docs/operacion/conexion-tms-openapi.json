  "webhooks": {
    "loteFirmado": {
      "post": {
        "summary": "Modo push (alternativa, apagado y SIN endpoint): el cliente empuja lotes firmados",
        "description": "Encabezados: x-likida-marca (segundos epoch; tolerancia 300 s), x-likida-firma (HMAC-SHA256 hex de «marca.llave.cuerpo»), idempotency-key. Máximo 5242880 bytes. Respuestas: 200, 400 sin llave, 401 firma, 403 marca, 409 repetido, 413 tamaño, 422 cuerpo, 503 apagado. Sin endpoint publicado.",
        "responses": {
          "200": {
            "description": "SUPUESTO, sin endpoint publicado: respuesta que daría la lógica de recepción."
          }
        },
        "x-supuesto": true
      }
    }
